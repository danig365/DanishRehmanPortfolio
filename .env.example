# Contact form (api/contact.ts) sends email through Gmail.
# Add these in Vercel → Project → Settings → Environment Variables.
# GMAIL_APP_PASSWORD is a Google app password (myaccount.google.com/apppasswords),
# not your normal password. Never commit real values.

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
CONTACT_TO=you@gmail.com
